<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= file.originalName %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("partials/navbar") %>
  
  <main class="container">

  </main>
  <p>
    <% if (file.folderId) { %>
      <a href="/folders/<%= file.folderId %>" class="back-link"> Back to folder</a>
    <% } else { %>
      <a href="/folders" class="back-link"> Back to folders</a>
    <% } %>
  </p>
  <section class="card">
  <h1><%= file.originalname %></h1>

  <ul class="details">
    <li><strong>Type:</strong> <%= file.mimetype %></li>
    <li><strong>Size:</strong> <%= (file.size / 1024).toFixed(1) %> KB</li>
    <li><strong>Uploaded:</strong> <%= file.createdAt.toLocaleString() %></li>
  </ul>

  <a href="/files/<%= file.id %>/download" class="btn">Download</a>
  </section>
  </main>
  
</body>

</html>