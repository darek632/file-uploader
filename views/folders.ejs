<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Folders</title>
</head>
<body>
  <%- include("partials/navbar") %>
  <h1>My Folders</h1>

  <h2>New folder</h2>
  <form action="/folders" method="POST">
    <label for="name">Folder name</label>
    <input type="text" id="name" name="name" required>
    <button type="submit">Create</button>
  </form>

  <h2>Folders</h2>
  <% if (folders.length === 0) { %>
    <p>You don't have any folders yet.</p>
  <% } else { %>
    <ul>
      <% folders.forEach(folder => { %>
        <li>
          <a href="/folders/<%= folder.id %>"><%= folder.name %></a>

          <form action="/folders/<%= folder.id %>/delete" method="POST" style="display:inline"
                onsubmit="return confirm('Delete this folder and all its files?');">
            <button type="submit">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <h3>Remaining files:</h3>
  <% if (files.length === 0) { %>
    <p>No loose files.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Size</th>
          <th>Uploaded</th>
        </tr>
      </thead>
      <tbody>
        <% files.forEach(file => { %>
          <tr>
            <td><a href="/files/<%= file.id%>"><%= file.originalname %></a></td>
            <td><%= file.mimetype %></td>
            <td><%= (file.size / 1024).toFixed(1) %> KB</td>
            <td><%= file.createdAt.toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>



  <p><a href="/upload-file">Upload a file without a folder</a></p>
</body>
</html>
