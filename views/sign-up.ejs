<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign up</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

 <%- include("partials/navbar") %>

  <main class="container">
    <section class="card auth-card">
      <h1>Sign up</h1>

      <form action="/sign-up" method="POST" class="stack-form">
        <label class="field">
          Username
          <input type="text" name="username" autocomplete="username" required>
        </label>
        <label class="field">
          Password
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <button type="submit" class="btn">Sign up</button>
      </form>

      <p class="auth-switch">Already have an account? <a href="/log-in">Log in</a></p>
    </section>
  </main>
</body>
</html>