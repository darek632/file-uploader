<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= folder.name %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("partials/navbar") %>

  <main class="section">

  <p><a href="/folders" class="back-link"> Back to folders</a></p>
  <div class="page-header">
    <h1><%= folder.name %></h1>
  </div>
  
  <section class="card">
  <h2>Rename folder</h2>
  <form action="/folders/<%= folder.id %>/update" method="POST">
    <label for="name">New name</label>
    <input type="text" id="name" name="name" value="<%= folder.name %>" required>
    <button type="submit" class="btn">Save</button>
  </form>
  </section>

  

  <section class="card">
  <h2>Upload a file to this folder</h2>
      <% if (locals.error) { %>
      <%= error %>
      <% } %>  
  <form action="/upload-file" method="POST" enctype="multipart/form-data" class="inline-form">
    <input type="hidden" name="folderId" value="<%= folder.id %>">
    <input type="file" name="uploaded_file" required>
    <button type="submit" class="btn">Upload</button>
  </form>
  </section>

  

<section class="card">
  <h3> Files</h3>
    <% if (folder.files.length === 0) { %>
    <p>No files in this folder</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Size</th>
            <th>Uploaded</th>
          </tr>
        </thead>
        <tbody>
          <% folder.files.forEach(file => { %>
            <tr>
              <td><a href="/files/<%= file.id%>"><%= file.originalname %></a></td>
              <td class="muted"><%= file.mimetype %></td>
              <td class="muted"><%= (file.size / 1024).toFixed(1) %> KB</td>
              <td class="muted"><%= file.createdAt.toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  

  <form action="/folders/<%= folder.id %>/delete" method="POST"
        onsubmit="return confirm('Delete this folder and all its files?');">
      <button type="submit" class="btn btn-danger btn-small">Delete folder</button>
  </form>
  </section>

  </main>
</body>
</html>
