<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>

  <%- include("partials/navbar") %>

    
    <% if (locals.currentUser) { %>
  <h1>Welcome, <%= currentUser.username %></h1>

  <p><a href="/folders">Go to my drive</a> to see your folders and files.</p>
  <a href="/log-out">Log out</a>
<% } else { %>
  <h1>File uploader</h1>
  <p>Store and organise your files in folders.</p>
  <p><a href="/sign-up">Sign up</a> or <a href="/log-in">Log in.</a></p>
<% } %>
    
</body>
</html>